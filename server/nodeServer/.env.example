# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-password

# Alternative: Custom SMTP
# EMAIL_SERVICE=custom
# EMAIL_HOST=your-smtp-host.com
# EMAIL_PORT=587
# EMAIL_USER=your-username
# EMAIL_PASS=your-password

