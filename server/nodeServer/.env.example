# Database Configuration# Database Configuration

PGUSER=postgresDATABASE_URL=postgresql://username:password@localhost:5432/ptit_job

PGPASSWORD=yourpassword

PGHOST=localhost# JWT Configuration

PGPORT=5432JWT_ACCESS_SECRET=your-super-secret-access-key-here

PGDATABASE=ptitjobJWT_REFRESH_SECRET=your-super-secret-refresh-key-here



# JWT Secret# Server Configuration

JWT_SECRET=your-super-secret-jwt-key-herePORT=5000

JWT_REFRESH_SECRET=your-super-secret-refresh-key-hereNODE_ENV=development



# Email Configuration (Mailtrap for development)# Email Configuration

EMAIL_HOST=sandbox.smtp.mailtrap.io

EMAIL_PORT=2525# Mailtrap (Recommended for development)

EMAIL_USER=your-mailtrap-usernameEMAIL_SERVICE=mailtrap

EMAIL_PASSWORD=your-mailtrap-passwordEMAIL_HOST=sandbox.smtp.mailtrap.io

EMAIL_FROM=noreply@ptitjob.comEMAIL_PORT=2525

EMAIL_USER=your-mailtrap-username

# Frontend URL for email linksEMAIL_PASS=your-mailtrap-password

FRONTEND_URL=http://localhost:3000

# For Mailtrap setup:

# Node Environment# 1. Go to https://mailtrap.io

NODE_ENV=development# 2. Sign up for free account

# 3. Create a new inbox

# Server Configuration# 4. Copy SMTP credentials from inbox settings

PORT=8080# 5. Use username/password as EMAIL_USER/EMAIL_PASS

# Alternative: Gmail
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# Alternative: Outlook
